# schedule-svc/.env.example

NODE_ENV=development
PORT=8082

DB_HOST=localhost
DB_PORT=3306
DB_NAME=schedule_db
DB_USER=root
DB_PASSWORD=password

NEIS_API_KEY=YOUR_NEIS_API_KEY
MOLIT_API_KEY=YOUR_MOLIT_API_KEY

INTERNAL_API_SECRET=YOUR_INTERNAL_API_SECRET

# 운영/테스트 환경에서만 활성화
ACADEMIC_SCHEDULE_CRON_ENABLED=false
ACADEMIC_SCHEDULE_CRON=0 3 * * *
ACADEMIC_SCHEDULE_CRON_TIMEZONE=Asia/Seoul